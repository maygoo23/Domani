# --- Application ---
SECRET_KEY=changeme-use-openssl-rand-hex-32
DEBUG=false
BASE_URL=http://localhost:8000

# --- Database ---
DATABASE_URL=sqlite:////data/domani.db

# --- WHOIS ---
WHOIS_TIMEOUT_SECONDS=10
WHOIS_RETRY_COUNT=3
WHOIS_RATE_LIMIT_SECONDS=2

# --- Scheduler ---
DEFAULT_CHECK_INTERVAL_HOURS=6
FAST_POLL_INTERVAL_MINUTES=5
EXPIRING_SOON_DAYS=30
EXPIRING_CRITICAL_DAYS=7

# --- Email (optional, can also be set in Settings UI) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=domani@yourdomain.com
SMTP_TLS=true
